<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>

  <!-- Controller de VR.
       El menú es un componente aparte —`luna://shell_menu`, montado como
       `<include>`— y lo que queda de este lado es el estado, las ventanas de
       apps y el puente con el motor.

       El corte no es de gusto: `bind_embedded_slot` exige que el nodo ancla de
       una ventana embebida pertenezca al space que manda el slot, y ese space es
       éste. Un marco dibujado dentro del include tendría el ancla en otro space
       y el slot sería rechazado. Por eso el menú se va y las ventanas se quedan. -->
  <space id="ux_vr" resources="desktop_camera_control,vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- El menú.
         `props` y `events` son lo que abre el canal de componentes: sin al menos
         uno de los dos, el motor no crea el Channel y el include queda mudo.
         `props` arranca vacío porque el estado real se lo manda el shell apenas
         monta; `events` declara los únicos tipos que el menú puede emitir — uno
         que no esté en esta lista se rechaza.

         No lleva `resources`: dibujar y recibir punteros no necesita permiso, y
         los includes **no** heredan nada por defecto. Si algún día el menú
         necesitara uno, habría que nombrarlo acá Y pedirlo en su `<space>`. -->
    <include id="ux_vr_menu"
             src="luna://shell_menu"
             props="{}"
             events="open,menu,window,close,hidden"/>

    <group id="ux_vr_focus_zone" visible="false"/>

    <!-- La zona de fijadas queda siempre visible: son sus hijos, uno por
         ventana, los que deciden. -->
    <group id="ux_vr_anchored_zone" visible="true"/>

    <script src="luna://internal/shell_draw.js"/>
    <script src="luna://internal/shell_app.js"/>
    <script>
      // ── Marcadores ───────────────────────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API.
      // kind: 'spatial' (default) | 'app' | 'app-embedded'
      const BOOKMARKS = [
        { name: 'Inicio',    url: 'luna://home',          kind: 'spatial' },
        { name: 'Ajustes',   url: 'luna://settings',      kind: 'app-embedded' },
        { name: 'Demos',     url: 'luna://demos',         kind: 'spatial' },
        { name: 'Demo App',  url: 'luna://demo_embedded', kind: 'app-embedded' },
        // El directorio del taller (server_puente): una puerta a cada proyecto.
        { name: 'Taller',    url: 'http://localhost:2050/', kind: 'spatial', glyph: 'app' },
      ];

      // Los scripts externos llegan asincrónicos y el motor no garantiza el
      // orden. Esperar a que los dos existan es más barato que ordenarlos, y
      // falla ruidoso si alguno no llegó.
      (function esperar(intentos) {
        if (!globalThis.ShellDraw || !globalThis.ShellApp) {
          if (intentos > 200) { console.warn('[ux_vr] el shell no llegó'); return; }
          setTimeout(() => esperar(intentos + 1), 16);
          return;
        }
        armar();
      })(0);

      function armar() {
        const root = hiperspace.dimention;

        const shell = globalThis.ShellApp.mount({
          root: root,
          menuInclude: root.getElementById('ux_vr_menu'),
          focusZone: root.getElementById('ux_vr_focus_zone'),
          anchoredZone: root.getElementById('ux_vr_anchored_zone'),
          bookmarks: BOOKMARKS,
          distance: 1.5,
          // El lienzo de una app, en metros. Va con la distancia: acá el menú
          // está cerca, así que una ventana de un metro ocupa más o menos lo
          // que ocupaba la grilla.
          slot: { w: 1.0, h: 0.7, d: 0.1 },

          // ── Todo lo que sale hacia el motor entra por acá ────────────────
          // El módulo no conoce `dimention` ni los ops del runtime: recibe
          // funciones. Eso es lo que le permite montarse en un controller que no
          // tenga concedidas las mismas capacidades.
          tabs: {
            open: (url, opts) => dimention.tabs.open(url, opts),
            close: (id) => dimention.tabs.close(id),
            setVisible: (id, v) => dimention.tabs.setVisible(id, v),
          },
          send: (tabId, payload) => Deno.core.ops.op_shell_send_message(BigInt(tabId), payload),
          poll: () => Deno.core.ops.op_shell_poll_messages(),
          viewerPose: () => (typeof dimention.readViewerPose === 'function'
            ? dimention.readViewerPose() : null),
          navigate: (url) => { location.href = url; },
        });

        // El botón menu del mando, normalizado por `system_input` — el mismo
        // evento que manda ESC en escritorio. Le llega a este space; el include
        // no lo necesita porque el estado del menú lo lleva el shell.
        root.addEventListener('systeminput', (evt) => {
          if (evt.action === 'shell') shell.toggle();
        });

        console.log('[ux_vr] shell montado — ' + BOOKMARKS.length + ' marcadores');
      }
    </script>
  </space>
</hsml>
