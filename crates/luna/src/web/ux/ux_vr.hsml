<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <space id="ux_vr" system-shell="true" resources="vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- Shell del UX en VR.
         Tres grupos top-level:
           - ux_vr_panel:      bookmarks grid (centro arriba).
           - ux_vr_bottom_bar: taskbar inferior (Menu + Focus + Anchored).
           - ux_vr_focus_zone: silueta del slot focused (commit 3+).
         Toda visibilidad deriva de ShellState (ver script). -->
    <group id="ux_vr_panel" visible="false">
      <!-- Bookmarks construidos dinámicamente vía script. -->
    </group>

    <group id="ux_vr_bottom_bar" visible="false">
      <!-- Slot 1: Menu (siempre si bar visible). Slots 2..N: focus + anchored.
           Construidos dinámicamente — ver buildBottomBar(). -->
    </group>

    <!-- ux_vr_focus_zone: vendrá en commit 3 cuando se implemente el focus. -->

    <script>
      // ────────────────────────────────────────────────────────────────────
      // ux_vr shell — orquesta bookmarks + bottom bar + (futuro) focus/anchored.
      // Implementación del state machine definido en docs/embedded_apps.md.
      // ────────────────────────────────────────────────────────────────────

      const root = hiperspace.dimention;

      // ── Bookmarks ──────────────────────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API.
      // kind:  'spatial' (default) | 'app' | 'app-embedded' (futuro)
      const BOOKMARKS = [
        { name: 'Home',     url: 'luna://home',        kind: 'spatial' },
        { name: 'Demos',    url: 'luna://demos',       kind: 'spatial' },
        { name: 'Settings', url: 'luna://settings',    kind: 'app' },
        { name: 'About',    url: 'luna://about',       kind: 'app' },
        { name: 'Scale',    url: 'luna://scale_demo',  kind: 'spatial' },
        { name: 'Fire',     url: 'luna://fire_demo',   kind: 'spatial' },
        { name: 'Target',   url: 'luna://target_demo', kind: 'spatial' },
        { name: 'Range',    url: 'luna://range_demo',  kind: 'spatial' },
      ];

      const PALETTE = [
        '#3B82F6', '#10B981', '#F59E0B', '#EF4444',
        '#8B5CF6', '#EC4899', '#14B8A6', '#F97316',
        '#22C55E', '#EAB308',
      ];

      // ── Tamaños (Quest 2 home style) ───────────────────────────────────
      const SIZE_APP    = 0.22;
      const BOX_DEPTH   = 0.025;
      const Z           = 0;       // local al panel
      const Z_TEXT      = 0.001;
      const LABEL_DY    = -0.15;
      const LABEL_SIZE  = 0.040;
      const BORDER_R    = '0.2';

      // ── Bottom bar (taskbar) ───────────────────────────────────────────
      const BAR_Y           = -0.55;   // debajo del panel principal
      const BAR_Z           = 0;       // mismo plano
      const BAR_SLOT_SIZE_X = 0.16;
      const BAR_SLOT_SIZE_Y = 0.10;
      const BAR_SLOT_DEPTH  = 0.020;
      const BAR_SLOT_GAP    = 0.04;
      const BAR_SLOT_BORDER = '0.15';
      const BAR_LABEL_SIZE  = 0.035;

      // ── buildPositions (layout cluster) ────────────────────────────────
      const POS_DIV = 4;
      const SPACEY = 1.5;
      const POSITIONS_TABLE = [
        [[4, 1]],
        [[3, 1], [5, 1]],
        [[2, 1], [4, 1], [6, 1]],
        [[1, 1], [3, 1], [5, 1], [7, 1]],
        [[0, 1], [2, 1], [4, 1], [6, 1], [8, 1]],
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY]],
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY], [5, 1 - SPACEY]],
        [[1, 1], [3, 1], [5, 1], [7, 1], [2, 1 - SPACEY], [6, 1 - SPACEY], [2, 1 + SPACEY], [6, 1 + SPACEY]],
      ];

      function computePositions(count) {
        if (count < 1) return [];
        if (count > POSITIONS_TABLE.length) {
          console.warn('[ux_vr]', count, 'bookmarks >', POSITIONS_TABLE.length, '— layout truncado');
          count = POSITIONS_TABLE.length;
        }
        const raw = POSITIONS_TABLE[count - 1].map(([x, y]) => [x / POS_DIV, y / POS_DIV]);
        let cx = 0, cy = 0;
        for (const [x, y] of raw) { cx += x; cy += y; }
        cx /= raw.length;
        cy /= raw.length;
        return raw.map(([x, y]) => [x - cx, y - cy]);
      }

      // ── Animación enter/exit ───────────────────────────────────────────
      const ANIM_MS    = 240;
      const STAGGER_MS = 30;
      function easeOutBack(t) {
        const c1 = 1.70158, c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
      }
      function easeInBack(t) {
        const c1 = 1.70158, c3 = c1 + 1;
        return c3 * t * t * t - c1 * t * t;
      }

      // ── ShellState ─────────────────────────────────────────────────────
      // State machine global del shell. Cualquier cambio acá DEBE ir seguido
      // de applyVisibility() para refrescar UI.
      const shellState = {
        bookmarksVisible: false,
        // Commits siguientes:
        focusApp: null,    // { tabId, minimized, slot:{position,rotation,size} }
        anchored: [],      // [{ tabId, position, rotation, minimized, alwaysOn }]
      };

      function shouldShowBookmarks() {
        // Bookmarks visibles si shell visible y no hay focus tomando la pantalla.
        if (!shellState.bookmarksVisible) return false;
        if (shellState.focusApp && !shellState.focusApp.minimized) return false;
        return true;
      }

      function shouldShowBottomBar() {
        // Bar sólo aparece si hay algo (focus o anchored) y el shell está visible.
        if (!shellState.bookmarksVisible) return false;
        const hasFocus = shellState.focusApp !== null;
        const hasAnchored = shellState.anchored.length > 0;
        return hasFocus || hasAnchored;
      }

      // ── DOM refs ───────────────────────────────────────────────────────
      const panel = root.getElementById('ux_vr_panel');
      const bottomBar = root.getElementById('ux_vr_bottom_bar');

      // ── Bookmark items refs (para anim cascada) ────────────────────────
      let itemRefs = []; // { box, text, idx }
      let animStartTs = 0;
      let animActive = false;
      let animMode = null;

      function clearBookmarks() {
        for (const ref of itemRefs) {
          try { if (ref.box)  ref.box.remove();  } catch (e) {}
          try { if (ref.text) ref.text.remove(); } catch (e) {}
        }
        itemRefs = [];
      }

      function buildBookmarks() {
        clearBookmarks();
        if (!panel) return;
        const positions = computePositions(BOOKMARKS.length);
        const n = Math.min(BOOKMARKS.length, positions.length);
        for (let i = 0; i < n; i++) {
          const bm = BOOKMARKS[i];
          const [px, py] = positions[i];
          const color = PALETTE[i % PALETTE.length];

          const box = root.createElement('box');
          box.setAttribute('name', 'app-' + bm.name);
          box.setAttribute('border-radius', BORDER_R);
          box.setAttribute('color', color);
          box.setAttribute('touchable', 'true');
          box.position = { x: px, y: py, z: Z };
          box.scale = { x: 0.001, y: 0.001, z: 0.001 };
          box.addEventListener('toque', () => openBookmark(bm));
          panel.appendChild(box);

          const text = root.createElement('text');
          text.setAttribute('name', 'app-name-' + bm.name);
          text.setAttribute('value', bm.name);
          text.setAttribute('size', String(LABEL_SIZE));
          text.position = { x: px, y: py + LABEL_DY, z: Z_TEXT };
          panel.appendChild(text);

          itemRefs.push({ box, text, idx: i });
        }
      }

      function applyScale(ref, factor) {
        if (!ref.box) return;
        const f = Math.max(0.001, factor);
        ref.box.scale = { x: SIZE_APP * f, y: SIZE_APP * f, z: BOX_DEPTH * f };
      }

      function startEnterAnimation() {
        for (const ref of itemRefs) applyScale(ref, 0);
        animStartTs = -1;
        animMode = 'enter';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }
      function startExitAnimation() {
        animStartTs = -1;
        animMode = 'exit';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }

      function tickAnim(ts) {
        if (!animActive) return;
        if (animStartTs < 0) animStartTs = ts;
        const elapsed = ts - animStartTs;
        const n = itemRefs.length;
        let stillRunning = false;
        for (const ref of itemRefs) {
          if (!ref.box) continue;
          const orderIdx = (animMode === 'exit') ? (n - 1 - ref.idx) : ref.idx;
          const itemElapsed = elapsed - orderIdx * STAGGER_MS;
          if (itemElapsed < 0) {
            applyScale(ref, animMode === 'enter' ? 0 : 1);
            stillRunning = true;
            continue;
          }
          if (itemElapsed >= ANIM_MS) {
            applyScale(ref, animMode === 'enter' ? 1 : 0);
            continue;
          }
          const t = itemElapsed / ANIM_MS;
          const progress = animMode === 'enter' ? easeOutBack(t) : (1 - easeInBack(t));
          applyScale(ref, progress);
          stillRunning = true;
        }
        if (stillRunning) {
          requestAnimationFrame(tickAnim);
        } else {
          animActive = false;
          if (animMode === 'exit' && panel) {
            panel.setAttribute('visible', 'false');
          }
          animMode = null;
        }
      }

      // ── Bottom bar build (esqueleto) ───────────────────────────────────
      // En este commit construimos sólo el slot Menu. Commits siguientes
      // agregan Focus indicator + Anchored entries.
      let barRefs = []; // { box, text }

      function clearBottomBar() {
        for (const r of barRefs) {
          try { if (r.box)  r.box.remove();  } catch (e) {}
          try { if (r.text) r.text.remove(); } catch (e) {}
        }
        barRefs = [];
      }

      function addBarSlot(x, label, color, onTap) {
        const box = root.createElement('box');
        box.setAttribute('border-radius', BAR_SLOT_BORDER);
        box.setAttribute('color', color);
        box.setAttribute('touchable', 'true');
        box.position = { x, y: BAR_Y, z: BAR_Z };
        box.scale = { x: BAR_SLOT_SIZE_X, y: BAR_SLOT_SIZE_Y, z: BAR_SLOT_DEPTH };
        if (typeof onTap === 'function') {
          box.addEventListener('toque', onTap);
        }
        bottomBar.appendChild(box);

        const text = root.createElement('text');
        text.setAttribute('value', label);
        text.setAttribute('size', String(BAR_LABEL_SIZE));
        text.setAttribute('color', '#FFFFFF');
        text.position = { x, y: BAR_Y, z: BAR_Z + 0.002 };
        bottomBar.appendChild(text);

        barRefs.push({ box, text });
      }

      function rebuildBottomBar() {
        clearBottomBar();
        if (!bottomBar) return;

        const slots = [];

        // Slot 1: Menu — siempre primero.
        slots.push({ label: 'Menu', color: '#4CAF50', onTap: onTapBarMenu });

        // Slot 2: Focus indicator (si existe focus).
        if (shellState.focusApp) {
          slots.push({
            label: 'Focus',
            color: shellState.focusApp.minimized ? '#90A4AE' : '#FFC107',
            onTap: onTapBarFocus,
          });
        }

        // Slot 3..N: anchored apps.
        for (let i = 0; i < shellState.anchored.length; i++) {
          const a = shellState.anchored[i];
          slots.push({
            label: 'Anc' + (i + 1),
            color: a.minimized ? '#607D8B' : '#7E57C2',
            onTap: () => onTapBarAnchored(i),
          });
          // TODO(commit 4): botón ✕ pequeño al lado de cada anchored.
        }

        // Layout horizontal centrado.
        const total = slots.length;
        const span = total * BAR_SLOT_SIZE_X + (total - 1) * BAR_SLOT_GAP;
        let cursor = -span / 2 + BAR_SLOT_SIZE_X / 2;
        for (const s of slots) {
          addBarSlot(cursor, s.label, s.color, s.onTap);
          cursor += BAR_SLOT_SIZE_X + BAR_SLOT_GAP;
        }
      }

      // ── Bar handlers ───────────────────────────────────────────────────
      function onTapBarMenu() {
        // Si hay focus visible → minimizar focus, mostrar bookmarks.
        if (shellState.focusApp && !shellState.focusApp.minimized) {
          shellState.focusApp.minimized = true;
          // TODO(commit 3): notificar a la app vía shell message 'blur'.
          applyVisibility();
          return;
        }
        // Sino: no-op (ya estamos en bookmarks).
        console.log('[ux_vr] bar Menu tapped — no-op (already in bookmarks)');
      }

      function onTapBarFocus() {
        // Restaura focus.
        if (!shellState.focusApp) return;
        shellState.focusApp.minimized = false;
        // TODO(commit 3): notificar 'focus' a la app.
        applyVisibility();
      }

      function onTapBarAnchored(idx) {
        const a = shellState.anchored[idx];
        if (!a) return;
        a.minimized = !a.minimized;
        // TODO(commit 4): notificar 'suspend'/'resume' a la app.
        applyVisibility();
      }

      // ── applyVisibility — derive UI from ShellState ────────────────────
      function applyVisibility() {
        if (panel)     panel.setAttribute('visible', shouldShowBookmarks() ? 'true' : 'false');
        if (bottomBar) bottomBar.setAttribute('visible', shouldShowBottomBar() ? 'true' : 'false');
        rebuildBottomBar();
        // TODO(commit 3): aplicar visibilidad de focus_app + anchored layers.
      }

      // ── Posicionar shell al frente del usuario ─────────────────────────
      const SHELL_SPAWN_DISTANCE = 1.5;

      function repositionShellAtViewer() {
        if (typeof dimention.readViewerPose !== 'function') return;
        const pose = dimention.readViewerPose();
        if (!pose) return;

        const fwdX = -Math.sin(pose.yaw);
        const fwdZ = -Math.cos(pose.yaw);

        // Mover ambos grupos juntos. Como son hijos del mismo space, podríamos
        // mover el space entero, pero por ahora movemos cada group para que el
        // commit siguiente pueda darle a focus/anchored una pose distinta.
        const px = pose.px + fwdX * SHELL_SPAWN_DISTANCE;
        const py = pose.py;
        const pz = pose.pz + fwdZ * SHELL_SPAWN_DISTANCE;
        const ry = pose.yaw;

        if (panel) {
          panel.position = { x: px, y: py, z: pz };
          panel.rotation = { x: 0, y: ry, z: 0 };
        }
        if (bottomBar) {
          // Mismo origen — los items dentro usan BAR_Y para offsetear abajo.
          bottomBar.position = { x: px, y: py, z: pz };
          bottomBar.rotation = { x: 0, y: ry, z: 0 };
        }
      }

      // ── Toggle shell (menu press del controller) ───────────────────────
      function toggleShell() {
        // Si hay focus visible (no minimizado): el shell aparece + focus minimizado.
        // Igual semántica que click en Menu de la bar.
        if (shellState.focusApp && !shellState.focusApp.minimized) {
          shellState.focusApp.minimized = true;
          shellState.bookmarksVisible = true;
          repositionShellAtViewer();
          applyVisibility();
          startEnterAnimation();
          return;
        }

        // Toggle simple del shell.
        const want = !shellState.bookmarksVisible;
        shellState.bookmarksVisible = want;

        if (want) {
          repositionShellAtViewer();
          applyVisibility();
          startEnterAnimation();
        } else {
          // Exit anim de los bookmarks; oculta bar inmediatamente
          // (la bar no tiene anim de exit propia en commit 2).
          if (bottomBar) bottomBar.setAttribute('visible', 'false');
          startExitAnimation();
        }
        console.log('[ux_vr] shell visible=', want);
      }

      // ── Bookmark click ─────────────────────────────────────────────────
      function openBookmark(bm) {
        if (!dimention || !dimention.tabs || typeof dimention.tabs.open !== 'function') {
          console.warn('[ux_vr] dimention.tabs unavailable — fallback location.href');
          location.href = bm.url;
          return;
        }
        // kind ∈ {'spatial', 'app', futuro 'app-embedded'}.
        dimention.tabs.open(bm.url, { kind: bm.kind || 'spatial' });

        // Cerrar shell al abrir (estilo Quest home). Commit 3 manejará el caso
        // app-embedded distinto (no cerrar bookmarks completamente, transicionar
        // a estado focused).
        shellState.bookmarksVisible = false;
        if (bottomBar) bottomBar.setAttribute('visible', 'false');
        startExitAnimation();
      }

      // ── Listener system input ──────────────────────────────────────────
      root.addEventListener('systeminput', (evt) => {
        if (evt.action === 'shell') {
          toggleShell();
        }
      });

      // ── Listener mensajes de apps embedded (commit 3+) ─────────────────
      // Por ahora sólo log para debug. Cuando exista demo_embedded app,
      // veremos los requestSlot / closeSelf / ready aparecer acá.
      if (dimention && dimention.embedded) {
        // El shell también tiene la API embedded? Sí, porque ux_vr tiene
        // managed-by=dimension.luna y el shell se pasa todos los grants en
        // switchMode. Pero NO usamos esa surface para iniciar mensajes:
        // el shell habla a apps vía ops directas (futuro shell_send_message
        // al inbox de cada app). Por ahora, prueba.
      }

      // ── Init ───────────────────────────────────────────────────────────
      buildBookmarks();
      applyVisibility();
      console.log('[ux_vr] Shell loaded — bookmarks=', BOOKMARKS.length, '(commit 2: ShellState + bottom bar skeleton)');
    </script>
  </space>
</hsml>
