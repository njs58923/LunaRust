<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
  </head>

  <!-- Controller de VR.
       No dibuja ni decide nada: arma los contenedores, carga el shell desde
       `luna://internal/shell_app.js` y le pasa por callbacks todo lo que sale
       hacia el motor. Las mil trescientas líneas que vivían acá —la máquina de
       estados de pestañas, slots y ventanas fijadas, más su interfaz— están en
       ese módulo, que también puede montar el controller de escritorio.

       Lo único propio de este archivo es lo que de verdad es propio de VR: qué
       marcadores hay, a qué distancia se planta el menú y que el botón menu del
       mando lo abre. -->
  <space id="ux_vr" resources="vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- Los cuatro contenedores. La visibilidad de cada uno la deriva el shell
         de su estado; acá sólo se declara el arranque. -->
    <group id="ux_vr_panel" visible="false"/>
    <group id="ux_vr_bottom_bar" visible="false"/>
    <group id="ux_vr_focus_zone" visible="false"/>
    <!-- La zona de fijadas queda siempre visible: son sus hijos, uno por
         ventana, los que deciden. -->
    <group id="ux_vr_anchored_zone" visible="true"/>

    <script src="luna://internal/shell_ui.js"/>
    <script src="luna://internal/shell_app.js"/>
    <script>
      // ── Marcadores ───────────────────────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API.
      // kind: 'spatial' (default) | 'app' | 'app-embedded'
      const BOOKMARKS = [
        { name: 'Inicio',    url: 'luna://home',          kind: 'spatial',      glyph: 'home' },
        { name: 'Ajustes',   url: 'luna://settings',      kind: 'app-embedded', glyph: 'settings' },
        { name: 'Demos',     url: 'luna://demos',         kind: 'spatial',      glyph: 'demos' },
        { name: 'Demo App',  url: 'luna://demo_embedded', kind: 'app-embedded', glyph: 'app' },
        { name: 'Acerca de', url: 'luna://about',         kind: 'app',          glyph: 'about' },
        { name: 'Scale',     url: 'luna://scale_demo',    kind: 'spatial',      glyph: 'scale' },
        { name: 'Fire',      url: 'luna://fire_demo',     kind: 'spatial',      glyph: 'fire' },
        { name: 'Target',    url: 'luna://target_demo',   kind: 'spatial',      glyph: 'target' },
        { name: 'Range',     url: 'luna://range_demo',    kind: 'spatial',      glyph: 'range' },
      ];

      // En VR el campo visual es ancho y el menú se mira girando la cabeza, así
      // que puede estar cerca. En escritorio, que es una ventana, el mismo menú
      // a esta distancia no entra en el cuadro.
      const DISTANCIA = 2.0;

      let shell = null;

      // Los dos scripts externos llegan asincrónicos y el motor no garantiza el
      // orden. Esperar a que los dos existan es más barato que ordenarlos, y
      // falla ruidoso si alguno no llegó.
      (function esperar(intentos) {
        if (!globalThis.ShellUI || !globalThis.ShellApp) {
          if (intentos > 200) { console.warn('[ux_vr] el shell no llegó'); return; }
          setTimeout(() => esperar(intentos + 1), 16);
          return;
        }
        armar();
      })(0);

      function armar() {
        const root = hiperspace.dimention;

        shell = globalThis.ShellApp.mount({
          root: root,
          panel: root.getElementById('ux_vr_panel'),
          bottomBar: root.getElementById('ux_vr_bottom_bar'),
          focusZone: root.getElementById('ux_vr_focus_zone'),
          anchoredZone: root.getElementById('ux_vr_anchored_zone'),
          bookmarks: BOOKMARKS,
          distance: DISTANCIA,
          title: 'Aplicaciones',

          rail: [
            { glyph: 'search', onTap: () => console.log('[ux_vr] buscar (pendiente)') },
            { glyph: 'add',    onTap: () => console.log('[ux_vr] agregar (pendiente)') },
            { glyph: 'edit',   onTap: () => console.log('[ux_vr] editar (pendiente)') },
          ],

          statusButtons: [
            { glyph: 'user', onTap: () => console.log('[ux_vr] usuario (pendiente)') },
            { glyph: 'home', onTap: () => shell && shell.openBookmark(BOOKMARKS[0]) },
            { glyph: 'bell', onTap: () => console.log('[ux_vr] avisos (pendiente)') },
          ],

          // ── Todo lo que sale hacia el motor entra por acá ────────────────
          // El módulo no conoce `dimention` ni los ops del runtime: recibe
          // funciones. Eso es lo que le permite correr igual en un controller
          // que no tenga las mismas capacidades concedidas.
          tabs: {
            open: (url, opts) => dimention.tabs.open(url, opts),
            close: (id) => dimention.tabs.close(id),
            setVisible: (id, v) => dimention.tabs.setVisible(id, v),
          },
          send: (tabId, payload) => Deno.core.ops.op_shell_send_message(BigInt(tabId), payload),
          poll: () => Deno.core.ops.op_shell_poll_messages(),
          viewerPose: () => (typeof dimention.readViewerPose === 'function'
            ? dimention.readViewerPose() : null),
          navigate: (url) => { location.href = url; },
        });

        // El botón menu del mando, normalizado por `system_input` — el mismo
        // evento que manda ESC en escritorio.
        root.addEventListener('systeminput', (evt) => {
          if (evt.action === 'shell') shell.toggle();
        });

        console.log('[ux_vr] shell montado — ' + BOOKMARKS.length + ' marcadores');
      }
    </script>
  </space>
</hsml>
