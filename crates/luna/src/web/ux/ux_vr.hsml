<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <space id="ux_vr" resources="vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- Panel oculto por defecto. Se muestra al recibir systeminput action=shell
         (botón menu Touch izq en VR, ESC desktop). El estado lo maneja este
         script — el dispatcher Bevy sólo emite el press. -->
    <group id="ux_vr_panel" visible="false">
      <!-- Items se construyen dinámicamente vía script; DOM resultante
           equivalente al de test/menu/script_menu.js (mismas attrs, mismo
           label y-offset). Tamaños escalados ~2x menor estilo Quest 2 home. -->
    </group>

    <script>
      // ────────────────────────────────────────────────────────────────────
      // ux_vr shell — bookmark launcher.
      // DOM-equivalente a public/test/menu/script_menu.js, con tamaños
      // reducidos ~2x (estilo Quest 2 home) y animación enter/exit.
      // ────────────────────────────────────────────────────────────────────

      const root = hiperspace.dimention;

      // ── Bookmarks ──────────────────────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API.
      //
      // kind:
      //   'spatial' (default): al abrir cierra otras spatial — "moverse a otro lugar"
      //   'app':              aditiva, persiste entre cambios de spatial
      //
      // En el futuro este kind lo sugerirá el doc destino (<space role=...>)
      // o lo declarará el usuario al guardar marcador. Hoy lo hardcodeamos.
      const BOOKMARKS = [
        { name: 'Home',     url: 'luna://home',        kind: 'spatial' },
        { name: 'Demos',    url: 'luna://demos',       kind: 'spatial' },
        { name: 'Settings', url: 'luna://settings',    kind: 'app' },
        { name: 'About',    url: 'luna://about',       kind: 'app' },
        { name: 'Scale',    url: 'luna://scale_demo',  kind: 'spatial' },
        { name: 'Fire',     url: 'luna://fire_demo',   kind: 'spatial' },
        { name: 'Target',   url: 'luna://target_demo', kind: 'spatial' },
        { name: 'Range',    url: 'luna://range_demo',  kind: 'spatial' },
      ];

      const PALETTE = [
        '#3B82F6', '#10B981', '#F59E0B', '#EF4444',
        '#8B5CF6', '#EC4899', '#14B8A6', '#F97316',
        '#22C55E', '#EAB308',
      ];

      // ── Tamaños (Quest 2 home style: ~2x más chico que el original) ────
      const SIZE_APP    = 0.22;
      const BOX_DEPTH   = 0.025;
      // Items son LOCAL al panel; Z=0 los pone en el plano del panel. El
      // panel se mueve al frente del user en repositionPanelAtViewer().
      const Z           = 0;
      const Z_TEXT      = 0.001;  // levemente al frente para no z-fight con boxes
      const LABEL_DY    = -0.15;
      const LABEL_SIZE  = 0.040;
      const BORDER_R    = '0.2';

      // ── buildPositions (ported de script_menu.js) ──────────────────────
      // Tabla [count-1] → array [x_table, y_table]. Convert: pos/POS_DIV.
      // POS_DIV pasó de 2 (original) a 4 (mitad de spacing, mismo ratio).
      const POS_DIV = 4;
      const SPACEY = 1.5;
      const POSITIONS_TABLE = [
        [[4, 1]],                                                                                          // 1
        [[3, 1], [5, 1]],                                                                                  // 2
        [[2, 1], [4, 1], [6, 1]],                                                                          // 3
        [[1, 1], [3, 1], [5, 1], [7, 1]],                                                                  // 4
        [[0, 1], [2, 1], [4, 1], [6, 1], [8, 1]],                                                          // 5
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY]],                       // 6
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY], [5, 1 - SPACEY]],      // 7
        // 8: extensión propia conservando estilo cluster.
        [[1, 1], [3, 1], [5, 1], [7, 1], [2, 1 - SPACEY], [6, 1 - SPACEY], [2, 1 + SPACEY], [6, 1 + SPACEY]],
      ];

      function computePositions(count) {
        if (count < 1) return [];
        if (count > POSITIONS_TABLE.length) {
          console.warn('[ux_vr]', count, 'bookmarks >', POSITIONS_TABLE.length,
            '— layout truncado');
          count = POSITIONS_TABLE.length;
        }
        const raw = POSITIONS_TABLE[count - 1].map(([x, y]) => [x / POS_DIV, y / POS_DIV]);
        // Centrar en (0, 0) restando el centroide — local space del panel.
        let cx = 0, cy = 0;
        for (const [x, y] of raw) { cx += x; cy += y; }
        cx /= raw.length;
        cy /= raw.length;
        return raw.map(([x, y]) => [x - cx, y - cy]);
      }

      // ── Animación enter/exit ───────────────────────────────────────────
      const ANIM_MS    = 240;
      const STAGGER_MS = 30;

      // Back-out: overshoot al final del enter → se siente "asentándose".
      function easeOutBack(t) {
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
      }
      // Back-in: anticipación al inicio del exit → "se hunde" antes de irse.
      function easeInBack(t) {
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return c3 * t * t * t - c1 * t * t;
      }

      // ── State ──────────────────────────────────────────────────────────
      const panel = root.getElementById('ux_vr_panel');
      let visible = false;
      let itemRefs = []; // { box, text, idx }
      let animStartTs = 0;
      let animActive = false;
      let animMode = null; // 'enter' | 'exit'

      function clearBookmarks() {
        for (const ref of itemRefs) {
          try { if (ref.box)  ref.box.remove();  } catch (e) {}
          try { if (ref.text) ref.text.remove(); } catch (e) {}
        }
        itemRefs = [];
      }

      function buildBookmarks() {
        clearBookmarks();
        if (!panel) return;

        const positions = computePositions(BOOKMARKS.length);
        const n = Math.min(BOOKMARKS.length, positions.length);

        for (let i = 0; i < n; i++) {
          const bm = BOOKMARKS[i];
          const [px, py] = positions[i];
          const color = PALETTE[i % PALETTE.length];

          const box = root.createElement('box');
          box.setAttribute('name', 'app-' + bm.name);
          box.setAttribute('border-radius', BORDER_R);
          box.setAttribute('color', color);
          box.setAttribute('touchable', 'true');
          box.position = { x: px, y: py, z: Z };
          // Empieza colapsado para que la anim de entrada se note.
          box.scale = { x: 0.001, y: 0.001, z: 0.001 };
          box.addEventListener('toque', () => openBookmark(bm));
          panel.appendChild(box);

          const text = root.createElement('text');
          text.setAttribute('name', 'app-name-' + bm.name);
          text.setAttribute('value', bm.name);
          text.setAttribute('size', String(LABEL_SIZE));
          text.position = { x: px, y: py + LABEL_DY, z: Z_TEXT };
          panel.appendChild(text);

          itemRefs.push({ box, text, idx: i });
        }
      }

      // ── Helpers de scale por item ──────────────────────────────────────
      function applyScale(ref, factor) {
        if (!ref.box) return;
        const f = Math.max(0.001, factor);
        ref.box.scale = { x: SIZE_APP * f, y: SIZE_APP * f, z: BOX_DEPTH * f };
      }

      function startEnterAnimation() {
        // Reset todos a 0 (cascada renacerá).
        for (const ref of itemRefs) applyScale(ref, 0);
        // -1 = sentinel: se setea en la 1ra llamada a tickAnim usando el
        // timestamp que pasa raf. NO usar performance.now() acá: el ts del
        // raf viene del clock de Bevy (time.elapsed) y performance.now() del
        // clock del isolate — timebases distintos, daría elapsed enorme.
        animStartTs = -1;
        animMode = 'enter';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }

      function startExitAnimation() {
        // Asume items en estado final (scale 1). Si vienen colapsados (anim
        // interrumpida), arrancan desde donde estén — visualmente OK.
        animStartTs = -1;
        animMode = 'exit';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }

      function tickAnim(ts) {
        if (!animActive) return;
        if (animStartTs < 0) animStartTs = ts;
        const elapsed = ts - animStartTs;
        const n = itemRefs.length;
        let stillRunning = false;

        for (const ref of itemRefs) {
          if (!ref.box) continue;
          // Exit invierte el orden: último item desaparece primero (mirror).
          const orderIdx = (animMode === 'exit') ? (n - 1 - ref.idx) : ref.idx;
          const itemElapsed = elapsed - orderIdx * STAGGER_MS;

          if (itemElapsed < 0) {
            // Aún no le toca a este item. Mantener estado inicial:
            //   enter → quedar colapsado.
            //   exit  → quedar en full size.
            applyScale(ref, animMode === 'enter' ? 0 : 1);
            stillRunning = true;
            continue;
          }
          if (itemElapsed >= ANIM_MS) {
            applyScale(ref, animMode === 'enter' ? 1 : 0);
            continue;
          }

          const t = itemElapsed / ANIM_MS;
          let progress;
          if (animMode === 'enter') {
            progress = easeOutBack(t);          // 0 → 1 con overshoot al final
          } else {
            progress = 1 - easeInBack(t);       // 1 → 0 con anticipación
          }
          applyScale(ref, progress);
          stillRunning = true;
        }

        if (stillRunning) {
          requestAnimationFrame(tickAnim);
        } else {
          animActive = false;
          // Exit completo → ahora sí ocultar el panel entero (mantenía
          // visible mientras animaba para que los items se vieran irse).
          if (animMode === 'exit' && panel) {
            panel.setAttribute('visible', 'false');
          }
          animMode = null;
        }
      }

      // Distancia panel ↔ viewer al spawnearlo enfrente.
      const SHELL_SPAWN_DISTANCE = 1.5;

      function repositionPanelAtViewer() {
        if (!panel) return;
        if (typeof dimention.readViewerPose !== 'function') {
          console.warn('[ux_vr] readViewerPose unavailable — panel queda en posición previa');
          return;
        }
        const pose = dimention.readViewerPose();
        if (!pose) {
          // No hay snapshot todavía (sesión recién iniciando). Dejar default.
          return;
        }

        // Sólo usamos yaw (no pitch ni roll) para que el panel quede vertical
        // como un cuadro colgado, no se incline si el user mira arriba/abajo.
        // Forward XZ-plano normalizado a partir de yaw:
        //   yaw=0 mira -Z, yaw=PI/2 mira -X, etc.
        const fwdX = -Math.sin(pose.yaw);
        const fwdZ = -Math.cos(pose.yaw);

        panel.position = {
          x: pose.px + fwdX * SHELL_SPAWN_DISTANCE,
          y: pose.py,                          // altura ojos del user
          z: pose.pz + fwdZ * SHELL_SPAWN_DISTANCE,
        };
        // Rotar panel para que mire al user (yaw del viewer).
        panel.rotation = { x: 0, y: pose.yaw, z: 0 };

        // Extras según modo — UX puede especializarse acá.
        if (pose.mode === 'vr') {
          // VR: podríamos usar pose.qx..qw para una rotación más fina si
          // quisiéramos incluir pitch. Por ahora yaw-only feel más estable.
        } else if (pose.mode === 'desktop') {
          // Desktop: pose.fovY/aspect disponibles si necesitamos un panel
          // tipo HUD en screen space. No usado por ahora.
        }
      }

      function setVisibleAndAnimate(v) {
        const want = !!v;
        if (want === visible && !animActive) return;
        visible = want;

        if (want) {
          repositionPanelAtViewer();
          if (panel) panel.setAttribute('visible', 'true');
          startEnterAnimation();
        } else {
          // No ocultamos el panel todavía — tickAnim lo hará tras el exit.
          startExitAnimation();
        }
      }

      function openBookmark(bm) {
        if (dimention && dimention.tabs && typeof dimention.tabs.open === 'function') {
          // kind ∈ {'spatial', 'app'}; default 'spatial' si bookmark no lo declara.
          dimention.tabs.open(bm.url, { kind: bm.kind || 'spatial' });
          setVisibleAndAnimate(false);
        } else {
          console.warn('[ux_vr] dimention.tabs unavailable — fallback location.href');
          location.href = bm.url;
        }
      }

      // ── Listener system input ──────────────────────────────────────────
      // action='shell' → toggle. Fuente: vr_menu | kb_escape.
      root.addEventListener('systeminput', (evt) => {
        console.log('[ux_vr] systeminput action=', evt.action, 'source=', evt.source);
        if (evt.action === 'shell') {
          setVisibleAndAnimate(!visible);
        }
      });

      buildBookmarks();
      console.log('[ux_vr] Shell loaded —', BOOKMARKS.length, 'bookmarks. Press menu to toggle.');
    </script>
  </space>
</hsml>
