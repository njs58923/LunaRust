<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <space id="ux_vr" resources="vr_locomotion,read_system_input,manage_tabs">
    <!-- Panel oculto por defecto. Se muestra al recibir systeminput action=shell
         (botón menu Touch izquierdo en VR, ESC en desktop). Estado lo maneja
         este script — el dispatcher Bevy sólo emite el press, sin toggle implícito. -->
    <group id="ux_vr_panel" visible="false">
      <plane x="0" y="1.5" z="-1.8" sx="2.20" sy="1.60" sz="1" color="#0D1B2A" id="ux_vr_panel_bg" />

      <text x="0" y="2.10" z="-1.75" value="Luna Shell" size="0.14" color="#64B5F6" />
      <text x="0" y="1.92" z="-1.75" value="Bookmarks — press menu to toggle" size="0.06" color="#90A4AE" />

      <!-- Bookmarks se construyen dinámicamente vía script. Sin nodes estáticos. -->

      <text x="0" y="0.85" z="-1.75" value="" size="0.05" id="ux_vr_status" color="#B0BEC5" />
    </group>

    <script>
      const root = hiperspace.dimention;
      const byId = (id) => root.getElementById(id);

      // ── Bookmarks (hardcoded por ahora) ────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API. Para editar:
      // sumar/quitar entries acá y rebuildBookmarks().
      const BOOKMARKS = [
        { name: 'Home',     url: 'luna://home' },
        { name: 'Demos',    url: 'luna://demos' },
        { name: 'Settings', url: 'luna://settings' },
        { name: 'About',    url: 'luna://about' },
        { name: 'Scale',    url: 'luna://scale_demo' },
        { name: 'Fire',     url: 'luna://fire_demo' },
        { name: 'Target',   url: 'luna://target_demo' },
        { name: 'Range',    url: 'luna://range_demo' },
      ];

      // ── Layout config ──────────────────────────────────────────────────────
      const PALETTE = [
        '#3B82F6', '#10B981', '#F59E0B', '#EF4444',
        '#8B5CF6', '#EC4899', '#14B8A6', '#F97316',
        '#22C55E', '#EAB308',
      ];
      const SIZE_X  = 0.46;
      const SIZE_Y  = 0.30;
      const SIZE_Z  = 0.05;
      const Z       = -1.75;
      const Z_TEXT  = -1.69;
      const ROWS_Y  = [1.55, 1.15];
      const COLS_X  = [-0.75, -0.25, 0.25, 0.75];

      // ── Animación entrada ──────────────────────────────────────────────────
      const ANIM_MS    = 220;
      const STAGGER_MS = 32;
      function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

      // ── State ──────────────────────────────────────────────────────────────
      const panel = byId('ux_vr_panel');
      let visible = false;
      let itemRefs = []; // { box, idx }
      let animStartTs = 0;
      let animActive = false;

      function setStatus(msg) {
        const el = byId('ux_vr_status');
        if (el) el.setAttribute('value', msg || '');
      }

      function clearBookmarks() {
        for (const ref of itemRefs) {
          try { if (ref.box)  ref.box.remove();  } catch (e) {}
          try { if (ref.text) ref.text.remove(); } catch (e) {}
        }
        itemRefs = [];
      }

      function buildBookmarks() {
        clearBookmarks();
        if (!panel) return;

        for (let i = 0; i < BOOKMARKS.length; i++) {
          const bm  = BOOKMARKS[i];
          const row = Math.floor(i / COLS_X.length);
          const col = i % COLS_X.length;
          if (row >= ROWS_Y.length) {
            console.warn('[ux_vr] bookmark', bm.name, 'sin slot — soporta hasta',
              ROWS_Y.length * COLS_X.length, 'items');
            break;
          }
          const x = COLS_X[col];
          const y = ROWS_Y[row];
          const color = PALETTE[i % PALETTE.length];

          const box = root.createElement('box');
          box.setAttribute('color', color);
          box.setAttribute('touchable', 'true');
          box.position = { x, y, z: Z };
          // Empieza colapsado para que la anim de entrada se note.
          box.scale = { x: 0.001, y: 0.001, z: 0.001 };
          box.addEventListener('toque', () => openBookmark(bm.url));
          panel.appendChild(box);

          const text = root.createElement('text');
          text.setAttribute('value', bm.name);
          text.setAttribute('size', String(0.075));
          text.setAttribute('color', '#FFFFFF');
          text.position = { x, y, z: Z_TEXT };
          panel.appendChild(text);

          itemRefs.push({ box, text, idx: i });
        }
      }

      function startEntryAnimation() {
        // Reset todos los items a escala mínima.
        for (const ref of itemRefs) {
          if (ref.box) ref.box.scale = { x: 0.001, y: 0.001, z: 0.001 };
        }
        animStartTs = performance.now();
        animActive = true;
        requestAnimationFrame(tickAnim);
      }

      function tickAnim(ts) {
        if (!animActive) return;
        // Si se ocultó mientras animaba, abortar.
        if (!visible) { animActive = false; return; }

        const elapsed = ts - animStartTs;
        let stillRunning = false;

        for (const ref of itemRefs) {
          if (!ref.box) continue;
          const itemElapsed = elapsed - ref.idx * STAGGER_MS;
          if (itemElapsed < 0) {
            // todavía no empezó este item
            stillRunning = true;
            continue;
          }
          if (itemElapsed >= ANIM_MS) {
            ref.box.scale = { x: SIZE_X, y: SIZE_Y, z: SIZE_Z };
            continue;
          }
          const t = itemElapsed / ANIM_MS;
          const e = easeOutCubic(t);
          ref.box.scale = { x: SIZE_X * e, y: SIZE_Y * e, z: SIZE_Z * e };
          stillRunning = true;
        }

        if (stillRunning) {
          requestAnimationFrame(tickAnim);
        } else {
          animActive = false;
        }
      }

      function setVisibleAndAnimate(v) {
        visible = !!v;
        if (panel) panel.setAttribute('visible', visible ? 'true' : 'false');
        if (visible) {
          startEntryAnimation();
        }
        console.log('[ux_vr] panel visible=', visible);
      }

      function openBookmark(url) {
        if (dimention && dimention.tabs && typeof dimention.tabs.open === 'function') {
          setStatus('Opening tab ' + url);
          dimention.tabs.open(url);
          // Auto-cerrar shell tras abrir bookmark (estilo Quest home).
          setVisibleAndAnimate(false);
        } else {
          console.warn('[ux_vr] dimention.tabs unavailable — fallback location.href');
          setStatus('Opening ' + url + ' (no tabs API)');
          location.href = url;
        }
      }

      // ── Listener system input ──────────────────────────────────────────────
      // action='shell' → toggle visibilidad. Origen: vr_menu (Touch izq) o
      // kb_escape (desktop ESC sin shooter mode activo).
      root.addEventListener('systeminput', (evt) => {
        console.log('[ux_vr] systeminput action=', evt.action, 'source=', evt.source);
        if (evt.action === 'shell') {
          setVisibleAndAnimate(!visible);
        }
      });

      // Build inicial. Los items se crean colapsados; sólo se expanden cuando
      // el usuario invoca el shell (startEntryAnimation tras setVisible(true)).
      buildBookmarks();

      console.log('[ux_vr] Shell loaded —', BOOKMARKS.length, 'bookmarks. Press menu to toggle.');
    </script>
  </space>
</hsml>
