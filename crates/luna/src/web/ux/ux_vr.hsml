<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX VR</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <space id="ux_vr" resources="vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- Shell del UX en VR.
         Tres grupos top-level:
           - ux_vr_panel:      bookmarks grid (centro arriba).
           - ux_vr_bottom_bar: taskbar inferior (Menu + Focus + Anchored).
           - ux_vr_focus_zone: silueta del slot focused (commit 3+).
         Toda visibilidad deriva de ShellState (ver script). -->
    <group id="ux_vr_panel" visible="false">
      <!-- Bookmarks construidos dinámicamente vía script. -->
    </group>

    <group id="ux_vr_bottom_bar" visible="false">
      <!-- Slot 1: Menu (siempre si bar visible). Slots 2..N: focus + anchored.
           Construidos dinámicamente — ver buildBottomBar(). -->
    </group>

    <group id="ux_vr_focus_zone" visible="false">
      <!-- Frame visual de la app focused: borde, titlebar, botones close/min/anchor.
           El contenido lo dibuja la app embedded en su propio space root,
           posicionado por el shell vía slot message. -->
    </group>

    <script>
      // ────────────────────────────────────────────────────────────────────
      // ux_vr shell — orquesta bookmarks + bottom bar + (futuro) focus/anchored.
      // Implementación del state machine definido en docs/embedded_apps.md.
      // ────────────────────────────────────────────────────────────────────

      const root = hiperspace.dimention;

      // ── Bookmarks ──────────────────────────────────────────────────────
      // TODO(persistence): mover a storage cuando exista API.
      // kind:  'spatial' (default) | 'app' | 'app-embedded' (futuro)
      const BOOKMARKS = [
        { name: 'Home',     url: 'luna://home',           kind: 'spatial' },
        { name: 'Demos',    url: 'luna://demos',          kind: 'spatial' },
        { name: 'Demo App', url: 'luna://demo_embedded',  kind: 'app-embedded' },
        { name: 'About',    url: 'luna://about',          kind: 'app' },
        { name: 'Scale',    url: 'luna://scale_demo',     kind: 'spatial' },
        { name: 'Fire',     url: 'luna://fire_demo',      kind: 'spatial' },
        { name: 'Target',   url: 'luna://target_demo',    kind: 'spatial' },
        { name: 'Range',    url: 'luna://range_demo',     kind: 'spatial' },
      ];

      const PALETTE = [
        '#3B82F6', '#10B981', '#F59E0B', '#EF4444',
        '#8B5CF6', '#EC4899', '#14B8A6', '#F97316',
        '#22C55E', '#EAB308',
      ];

      // ── Tamaños (Quest 2 home style) ───────────────────────────────────
      const SIZE_APP    = 0.22;
      const BOX_DEPTH   = 0.025;
      const Z           = 0;       // local al panel
      const Z_TEXT      = 0.001;
      const LABEL_DY    = -0.15;
      const LABEL_SIZE  = 0.040;
      const BORDER_R    = '0.2';

      // ── Bottom bar (taskbar) ───────────────────────────────────────────
      const BAR_Y           = -0.55;
      const BAR_Z           = 0;
      const BAR_SLOT_SIZE_X = 0.16;
      const BAR_SLOT_SIZE_Y = 0.10;
      const BAR_SLOT_DEPTH  = 0.020;
      const BAR_SLOT_GAP    = 0.04;
      const BAR_SLOT_BORDER = '0.15';
      const BAR_LABEL_SIZE  = 0.035;

      // ── Focus zone (frame del focus app) ───────────────────────────────
      // Dimensiones del slot: el shell decide el tamaño, las apps reciben
      // un slot.size. Por ahora fijo.
      const FOCUS_SLOT_W  = 1.0;
      const FOCUS_SLOT_H  = 0.7;
      const FOCUS_SLOT_D  = 0.1;
      const FOCUS_FRAME_THICK = 0.015;
      const FOCUS_TITLEBAR_H  = 0.08;
      const FOCUS_BTN_SIZE   = 0.06;
      const FOCUS_BTN_GAP    = 0.012;

      const SHELL_SPAWN_DISTANCE = 1.5;

      // ── buildPositions (layout cluster) ────────────────────────────────
      const POS_DIV = 4;
      const SPACEY = 1.5;
      const POSITIONS_TABLE = [
        [[4, 1]],
        [[3, 1], [5, 1]],
        [[2, 1], [4, 1], [6, 1]],
        [[1, 1], [3, 1], [5, 1], [7, 1]],
        [[0, 1], [2, 1], [4, 1], [6, 1], [8, 1]],
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY]],
        [[2, 1], [4, 1], [6, 1], [3, 1 - SPACEY], [5, 1 + SPACEY], [3, 1 + SPACEY], [5, 1 - SPACEY]],
        [[1, 1], [3, 1], [5, 1], [7, 1], [2, 1 - SPACEY], [6, 1 - SPACEY], [2, 1 + SPACEY], [6, 1 + SPACEY]],
      ];

      function computePositions(count) {
        if (count < 1) return [];
        if (count > POSITIONS_TABLE.length) {
          console.warn('[ux_vr]', count, 'bookmarks >', POSITIONS_TABLE.length, '— layout truncado');
          count = POSITIONS_TABLE.length;
        }
        const raw = POSITIONS_TABLE[count - 1].map(([x, y]) => [x / POS_DIV, y / POS_DIV]);
        let cx = 0, cy = 0;
        for (const [x, y] of raw) { cx += x; cy += y; }
        cx /= raw.length;
        cy /= raw.length;
        return raw.map(([x, y]) => [x - cx, y - cy]);
      }

      // ── Animación enter/exit ───────────────────────────────────────────
      const ANIM_MS    = 240;
      const STAGGER_MS = 30;
      function easeOutBack(t) {
        const c1 = 1.70158, c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
      }
      function easeInBack(t) {
        const c1 = 1.70158, c3 = c1 + 1;
        return c3 * t * t * t - c1 * t * t;
      }

      // ── ShellState ─────────────────────────────────────────────────────
      // State machine global del shell. Cualquier cambio acá DEBE ir seguido
      // de applyVisibility() para refrescar UI.
      const shellState = {
        bookmarksVisible: false,
        // Commits siguientes:
        focusApp: null,    // { tabId, minimized, slot:{position,rotation,size} }
        anchored: [],      // [{ tabId, position, rotation, minimized, alwaysOn }]
      };

      function shouldShowBookmarks() {
        // Bookmarks visibles si shell visible y no hay focus tomando la pantalla.
        if (!shellState.bookmarksVisible) return false;
        if (shellState.focusApp && !shellState.focusApp.minimized) return false;
        return true;
      }

      // Regla literal del doc:
      //   bottom_bar.visible = bookmarks_visible && (focus.is_some() || anchored.len > 0)
      // bookmarksVisible se mantiene `true` durante toda la sesión del shell
      // (incluyendo cuando se abre una app embedded — el panel se oculta solo
      // por la regla de shouldShowBookmarks, pero el flag sigue true). Eso
      // hace que la bar quede visible para volver a marcadores desde una app.
      function shouldShowBottomBar() {
        if (!shellState.bookmarksVisible) return false;
        const hasFocus = shellState.focusApp !== null;
        const hasAnchored = shellState.anchored.length > 0;
        return hasFocus || hasAnchored;
      }

      // ── DOM refs ───────────────────────────────────────────────────────
      const panel = root.getElementById('ux_vr_panel');
      const bottomBar = root.getElementById('ux_vr_bottom_bar');
      const focusZone = root.getElementById('ux_vr_focus_zone');

      // ── Bookmark items refs (para anim cascada) ────────────────────────
      let itemRefs = []; // { box, text, idx }
      let animStartTs = 0;
      let animActive = false;
      let animMode = null;

      function clearBookmarks() {
        for (const ref of itemRefs) {
          try { if (ref.box)  ref.box.remove();  } catch (e) {}
          try { if (ref.text) ref.text.remove(); } catch (e) {}
        }
        itemRefs = [];
      }

      function buildBookmarks() {
        clearBookmarks();
        if (!panel) return;
        const positions = computePositions(BOOKMARKS.length);
        const n = Math.min(BOOKMARKS.length, positions.length);
        for (let i = 0; i < n; i++) {
          const bm = BOOKMARKS[i];
          const [px, py] = positions[i];
          const color = PALETTE[i % PALETTE.length];

          const box = root.createElement('box');
          box.setAttribute('name', 'app-' + bm.name);
          box.setAttribute('border-radius', BORDER_R);
          box.setAttribute('color', color);
          box.setAttribute('touchable', 'true');
          box.position = { x: px, y: py, z: Z };
          box.scale = { x: 0.001, y: 0.001, z: 0.001 };
          box.addEventListener('toque', () => openBookmark(bm));
          panel.appendChild(box);

          const text = root.createElement('text');
          text.setAttribute('name', 'app-name-' + bm.name);
          text.setAttribute('value', bm.name);
          text.setAttribute('size', String(LABEL_SIZE));
          text.position = { x: px, y: py + LABEL_DY, z: Z_TEXT };
          panel.appendChild(text);

          itemRefs.push({ box, text, idx: i });
        }
      }

      function applyScale(ref, factor) {
        if (!ref.box) return;
        const f = Math.max(0.001, factor);
        ref.box.scale = { x: SIZE_APP * f, y: SIZE_APP * f, z: BOX_DEPTH * f };
      }

      function startEnterAnimation() {
        for (const ref of itemRefs) applyScale(ref, 0);
        animStartTs = -1;
        animMode = 'enter';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }
      function startExitAnimation() {
        animStartTs = -1;
        animMode = 'exit';
        animActive = true;
        requestAnimationFrame(tickAnim);
      }

      function tickAnim(ts) {
        if (!animActive) return;
        if (animStartTs < 0) animStartTs = ts;
        const elapsed = ts - animStartTs;
        const n = itemRefs.length;
        let stillRunning = false;
        for (const ref of itemRefs) {
          if (!ref.box) continue;
          const orderIdx = (animMode === 'exit') ? (n - 1 - ref.idx) : ref.idx;
          const itemElapsed = elapsed - orderIdx * STAGGER_MS;
          if (itemElapsed < 0) {
            applyScale(ref, animMode === 'enter' ? 0 : 1);
            stillRunning = true;
            continue;
          }
          if (itemElapsed >= ANIM_MS) {
            applyScale(ref, animMode === 'enter' ? 1 : 0);
            continue;
          }
          const t = itemElapsed / ANIM_MS;
          const progress = animMode === 'enter' ? easeOutBack(t) : (1 - easeInBack(t));
          applyScale(ref, progress);
          stillRunning = true;
        }
        if (stillRunning) {
          requestAnimationFrame(tickAnim);
        } else {
          animActive = false;
          if (animMode === 'exit' && panel) {
            panel.setAttribute('visible', 'false');
          }
          animMode = null;
        }
      }

      // ── Bottom bar (diff incremental) ──────────────────────────────────
      // Las entries se reusan entre `applyVisibility()` calls — solo cambian
      // attrs (color, label, onTap) y position cuando hace falta. Sin esto,
      // cada applyVisibility destruía/recreaba todos los boxes → parpadeo.
      let barEntries = []; // { box, text, key, onTap, label, color, x }

      function buildBarSlot(x, label, color, onTap, key) {
        const box = root.createElement('box');
        box.setAttribute('border-radius', BAR_SLOT_BORDER);
        box.setAttribute('color', color);
        box.setAttribute('touchable', 'true');
        box.position = { x, y: BAR_Y, z: BAR_Z };
        box.scale = { x: BAR_SLOT_SIZE_X, y: BAR_SLOT_SIZE_Y, z: BAR_SLOT_DEPTH };
        const onTapWrapper = () => {
          const entry = barEntries.find(e => e.box === box);
          if (entry && typeof entry.onTap === 'function') entry.onTap();
        };
        box.addEventListener('toque', onTapWrapper);
        bottomBar.appendChild(box);

        const text = root.createElement('text');
        text.setAttribute('value', label);
        text.setAttribute('size', String(BAR_LABEL_SIZE));
        text.setAttribute('color', '#FFFFFF');
        text.position = { x, y: BAR_Y, z: BAR_Z + 0.002 };
        bottomBar.appendChild(text);

        return { box, text, key, onTap, label, color, x };
      }

      function updateBarSlot(entry, x, label, color, onTap) {
        if (entry.color !== color) {
          entry.box.setAttribute('color', color);
          entry.color = color;
        }
        if (entry.label !== label) {
          entry.text.setAttribute('value', label);
          entry.label = label;
        }
        if (Math.abs(entry.x - x) > 0.0001) {
          entry.box.position = { x, y: BAR_Y, z: BAR_Z };
          entry.text.position = { x, y: BAR_Y, z: BAR_Z + 0.002 };
          entry.x = x;
        }
        // onTap puede cambiar (indices anchored). Actualizar solo la ref;
        // el wrapper interno lee de barEntries.
        entry.onTap = onTap;
      }

      function removeBarSlot(entry) {
        try { if (entry.box)  entry.box.remove();  } catch (e) {}
        try { if (entry.text) entry.text.remove(); } catch (e) {}
      }

      function rebuildBottomBar() {
        if (!bottomBar) return;

        // Lista lógica de slots (key estable + props actuales).
        const slots = [];
        slots.push({ key: 'menu', label: 'Menu', color: '#4CAF50', onTap: onTapBarMenu });
        if (shellState.focusApp) {
          slots.push({
            key: 'focus',
            label: 'Focus',
            color: shellState.focusApp.minimized ? '#90A4AE' : '#FFC107',
            onTap: onTapBarFocus,
          });
        }
        for (let i = 0; i < shellState.anchored.length; i++) {
          const a = shellState.anchored[i];
          const idx = i;
          slots.push({
            key: 'anc:' + idx,
            label: 'Anc' + (i + 1),
            color: a.minimized ? '#607D8B' : '#7E57C2',
            onTap: () => onTapBarAnchored(idx),
          });
        }

        // Layout horizontal centrado.
        const total = slots.length;
        const span = total * BAR_SLOT_SIZE_X + (total - 1) * BAR_SLOT_GAP;
        let cursor = -span / 2 + BAR_SLOT_SIZE_X / 2;
        for (const s of slots) {
          s.x = cursor;
          cursor += BAR_SLOT_SIZE_X + BAR_SLOT_GAP;
        }

        // Diff: actualiza existentes, agrega nuevos, remueve obsoletos.
        const keepKeys = new Set(slots.map(s => s.key));
        // Remover los que ya no están.
        barEntries = barEntries.filter(e => {
          if (keepKeys.has(e.key)) return true;
          removeBarSlot(e);
          return false;
        });

        // Para cada slot deseado, actualizar o crear.
        for (const s of slots) {
          const existing = barEntries.find(e => e.key === s.key);
          if (existing) {
            updateBarSlot(existing, s.x, s.label, s.color, s.onTap);
          } else {
            barEntries.push(buildBarSlot(s.x, s.label, s.color, s.onTap, s.key));
          }
        }
      }

      // ── Bar handlers ───────────────────────────────────────────────────
      function onTapBarMenu() {
        if (shellState.focusApp && !shellState.focusApp.minimized) {
          shellState.focusApp.minimized = true;
          if (shellState.focusApp.tabId > 0) {
            if (dimention.tabs) dimention.tabs.setVisible(shellState.focusApp.tabId, false);
            sendMessageToApp(shellState.focusApp.tabId, 'blur');
          }
          shellState.bookmarksVisible = true;
          applyVisibility();
          return;
        }
        // bar Menu tap sin focus → no-op (ya estamos en bookmarks).
      }

      function onTapBarFocus() {
        if (!shellState.focusApp) return;
        shellState.focusApp.minimized = false;
        // bookmarksVisible queda true (sesión sigue activa). Las reglas de
        // visibilidad ocultan panel automáticamente porque focus !minimized.
        if (shellState.focusApp.tabId > 0) {
          if (dimention.tabs) dimention.tabs.setVisible(shellState.focusApp.tabId, true);
          sendMessageToApp(shellState.focusApp.tabId, 'focus');
          // No re-enviamos slot — la app queda en la pose previa, alineada
          // con el frame del shell. La pose sólo cambia cuando el shell se
          // mueve (repositionShellAtViewer).
        }
        applyVisibility();
      }

      function onTapBarAnchored(idx) {
        const a = shellState.anchored[idx];
        if (!a) return;
        a.minimized = !a.minimized;
        // TODO(commit 4): notificar 'suspend'/'resume' a la app.
        applyVisibility();
      }

      // ── applyVisibility — derive UI from ShellState ────────────────────
      function applyVisibility() {
        if (panel)     panel.setAttribute('visible', shouldShowBookmarks() ? 'true' : 'false');
        if (bottomBar) bottomBar.setAttribute('visible', shouldShowBottomBar() ? 'true' : 'false');
        rebuildBottomBar();

        // Focus zone (frame): visible si hay focus no-minimizado Y el frame
        // ya está construido (focusApp.tabId > 0). Esto evita el parpadeo de
        // un focusZone vacío durante los ~100ms entre openEmbeddedApp() y la
        // llegada del primer mensaje de la app que dispara buildFocusFrame.
        const showFocus = shellState.focusApp
          && !shellState.focusApp.minimized
          && shellState.focusApp.tabId > 0;
        if (focusZone) focusZone.setAttribute('visible', showFocus ? 'true' : 'false');
      }

      // ── Posicionar shell al frente del usuario ─────────────────────────
      function repositionShellAtViewer() {
        if (typeof dimention.readViewerPose !== 'function') return;
        const pose = dimention.readViewerPose();
        if (!pose) return;

        const fwdX = -Math.sin(pose.yaw);
        const fwdZ = -Math.cos(pose.yaw);

        // Mover ambos grupos juntos. Como son hijos del mismo space, podríamos
        // mover el space entero, pero por ahora movemos cada group para que el
        // commit siguiente pueda darle a focus/anchored una pose distinta.
        const px = pose.px + fwdX * SHELL_SPAWN_DISTANCE;
        const py = pose.py;
        const pz = pose.pz + fwdZ * SHELL_SPAWN_DISTANCE;
        const ry = pose.yaw;

        if (panel) {
          panel.position = { x: px, y: py, z: pz };
          panel.rotation = { x: 0, y: ry, z: 0 };
        }
        if (bottomBar) {
          bottomBar.position = { x: px, y: py, z: pz };
          bottomBar.rotation = { x: 0, y: ry, z: 0 };
        }
        if (focusZone) {
          focusZone.position = { x: px, y: py, z: pz };
          focusZone.rotation = { x: 0, y: ry, z: 0 };
        }
        // Si hay focus visible, re-enviar slot a la app (la pose cambió).
        if (shellState.focusApp && !shellState.focusApp.minimized && shellState.focusApp.tabId > 0) {
          sendFocusSlotToApp();
        }
      }

      // ── Toggle shell (menu press del controller) ───────────────────────
      // Transiciones del doc (docs/embedded_apps.md sección "Transiciones"):
      //   focus visible (!minimized)     → focus.minimized=true, bookmarks visible.
      //   shell hidden (algo visible)    → bookmarks visible, bar visible, anchored restaurados.
      //   bookmarks visible (sin focus)  → bookmarks hidden, bar hidden, anchored !always_on ocultos.
      //
      // `bookmarksVisible` es el flag de sesión: true mientras cualquier
      // pieza del shell sea visible o esté minimizada-pero-vigente. Volverá
      // a false sólo cuando el user oculta todo via menu press.
      function toggleShell() {
        // Branch: focus visible → minimizar focus, mostrar bookmarks. (= 🏠)
        if (shellState.focusApp && !shellState.focusApp.minimized) {
          shellState.focusApp.minimized = true;
          if (shellState.focusApp.tabId > 0) {
            if (dimention.tabs) dimention.tabs.setVisible(shellState.focusApp.tabId, false);
            sendMessageToApp(shellState.focusApp.tabId, 'blur');
          }
          // bookmarksVisible ya era true (sesión activa con focus). Idempotent.
          applyVisibility();
          startEnterAnimation();
          return;
        }

        // Branch: simple toggle on/off.
        const wasActive = shellState.bookmarksVisible;
        shellState.bookmarksVisible = !wasActive;

        if (!wasActive) {
          // off → on: reposicionar al frente del user (sesión nueva).
          repositionShellAtViewer();
          applyVisibility();
          startEnterAnimation();
        } else {
          // on → off: cerrar sesión. Exit anim.
          applyVisibility();
          startExitAnimation();
        }
      }

      // ── Frame del focus (titlebar + border) ────────────────────────────
      let focusFrameRefs = []; // { box, text }

      function clearFocusFrame() {
        for (const r of focusFrameRefs) {
          try { if (r.box)  r.box.remove();  } catch (_) {}
          try { if (r.text) r.text.remove(); } catch (_) {}
        }
        focusFrameRefs = [];
      }

      function addFrameBox(opts) {
        const box = root.createElement('box');
        box.setAttribute('color', opts.color || '#1a1a2e');
        if (opts.borderRadius) box.setAttribute('border-radius', String(opts.borderRadius));
        if (opts.touchable) box.setAttribute('touchable', 'true');
        box.position = { x: opts.x, y: opts.y, z: opts.z };
        box.scale = { x: opts.sx, y: opts.sy, z: opts.sz };
        if (typeof opts.onTap === 'function') {
          box.addEventListener('toque', opts.onTap);
        }
        focusZone.appendChild(box);
        focusFrameRefs.push({ box });
        return box;
      }

      function addFrameText(opts) {
        const text = root.createElement('text');
        text.setAttribute('value', String(opts.value || ''));
        text.setAttribute('size', String(opts.size || 0.04));
        text.setAttribute('color', opts.color || '#FFFFFF');
        text.position = { x: opts.x, y: opts.y, z: opts.z };
        focusZone.appendChild(text);
        focusFrameRefs.push({ text });
        return text;
      }

      function buildFocusFrame(title) {
        clearFocusFrame();
        if (!focusZone) return;

        const W = FOCUS_SLOT_W;
        const H = FOCUS_SLOT_H;
        const T = FOCUS_TITLEBAR_H;
        const TH = FOCUS_FRAME_THICK;

        // Borde de fondo (un solo plane atrás).
        addFrameBox({ x: 0, y: 0, z: -0.005,
                      sx: W + TH * 2, sy: H + T + TH * 2, sz: 0.005,
                      color: '#0D1B2A', borderRadius: 0.04 });

        // Titlebar arriba.
        const titleY = H / 2 + T / 2;
        addFrameBox({ x: 0, y: titleY, z: 0,
                      sx: W, sy: T, sz: 0.012,
                      color: '#1a2030', borderRadius: 0.02 });
        addFrameText({ x: -W/2 + 0.06, y: titleY, z: 0.008,
                       value: title || 'App', size: 0.035, color: '#B0BEC5' });

        // Botones titlebar (de derecha a izq): close, min, anchor.
        const btnY = titleY;
        let bx = W / 2 - FOCUS_BTN_SIZE / 2 - 0.02;
        // Close (rojo)
        addFrameBox({ x: bx, y: btnY, z: 0.012,
                      sx: FOCUS_BTN_SIZE, sy: FOCUS_BTN_SIZE, sz: 0.012,
                      color: '#EF4444', borderRadius: 0.02, touchable: true,
                      onTap: onTapFocusClose });
        addFrameText({ x: bx, y: btnY, z: 0.020, value: 'X', size: 0.035 });
        // Minimize (gris)
        bx -= FOCUS_BTN_SIZE + FOCUS_BTN_GAP;
        addFrameBox({ x: bx, y: btnY, z: 0.012,
                      sx: FOCUS_BTN_SIZE, sy: FOCUS_BTN_SIZE, sz: 0.012,
                      color: '#90A4AE', borderRadius: 0.02, touchable: true,
                      onTap: onTapFocusMinimize });
        addFrameText({ x: bx, y: btnY, z: 0.020, value: '_', size: 0.045 });
        // Anchor (azul)
        bx -= FOCUS_BTN_SIZE + FOCUS_BTN_GAP;
        addFrameBox({ x: bx, y: btnY, z: 0.012,
                      sx: FOCUS_BTN_SIZE, sy: FOCUS_BTN_SIZE, sz: 0.012,
                      color: '#3B82F6', borderRadius: 0.02, touchable: true,
                      onTap: onTapFocusAnchor });
        addFrameText({ x: bx, y: btnY, z: 0.020, value: '#', size: 0.04 });

        // Viewport silhouette (un cuadro fino para indicar el slot — la app
        // dibuja por encima en world coords).
        addFrameBox({ x: 0, y: 0, z: -0.001,
                      sx: W, sy: H, sz: 0.002,
                      color: '#16213E', borderRadius: 0.02 });
      }

      // ── Slot pose computation ──────────────────────────────────────────
      // Posición world del focus slot = pose del shell + offset al frente.
      // El frame visual (focusZone) está local al space ux_vr, así que el
      // shell mueve focusZone en local coords (mismo origen del panel).
      // La pose del slot del focus es la MISMA pose que el shell.
      // Ambos comparten posición/rotación porque el frame se renderiza junto
      // a los bookmarks. Leemos del panel, que es el source-of-truth de la
      // pose del shell — se actualiza solo en `repositionShellAtViewer` cuando
      // el menú aparece. Si abriéramos una app y leyéramos del viewer en
      // tiempo real, el shell se reposicionaría según la cabeza del user en
      // ese instante → la app + frame saltarían respecto al menú visible.
      function computeFocusSlotPose() {
        const fallback = {
          position: { x: 0, y: 1.5, z: -1.5 },
          rotation: { x: 0, y: 0, z: 0 },
          size: { x: FOCUS_SLOT_W, y: FOCUS_SLOT_H, z: FOCUS_SLOT_D },
        };
        if (!panel) return fallback;
        let p, r;
        try { p = panel.position; } catch (_) { return fallback; }
        try { r = panel.rotation; } catch (_) { return fallback; }
        return {
          position: { x: Number(p.x || 0), y: Number(p.y || 0), z: Number(p.z || 0) },
          rotation: { x: Number(r.x || 0), y: Number(r.y || 0), z: Number(r.z || 0) },
          size: { x: FOCUS_SLOT_W, y: FOCUS_SLOT_H, z: FOCUS_SLOT_D },
        };
      }

      // Envía el slot pose actual a la app focused.
      function sendFocusSlotToApp() {
        if (!shellState.focusApp) return;
        const slot = computeFocusSlotPose();
        const payload = JSON.stringify({ type: 'slot',
          position: slot.position,
          rotation: slot.rotation,
          size: slot.size,
        });
        Deno.core.ops.op_shell_send_message(BigInt(shellState.focusApp.tabId), payload);
      }

      function sendMessageToApp(tabId, type, extra) {
        const payload = JSON.stringify(Object.assign({ type }, extra || {}));
        Deno.core.ops.op_shell_send_message(BigInt(tabId), payload);
      }

      // ── Handlers titlebar focus ────────────────────────────────────────
      function onTapFocusClose() {
        if (!shellState.focusApp) return;
        const tabId = shellState.focusApp.tabId;
        // Notificar a la app antes de unmount (oportunidad de cleanup).
        sendMessageToApp(tabId, 'close');
        // Unmount inmediato; la app pierde su isolate (worker shutdown).
        // TODO(commit watchdog): esperar ack o timeout 500ms.
        if (dimention && dimention.tabs && typeof dimention.tabs.close === 'function') {
          dimention.tabs.close(tabId);
        }
        shellState.focusApp = null;
        shellState.bookmarksVisible = true;
        applyVisibility();
      }

      function onTapFocusMinimize() {
        if (!shellState.focusApp) return;
        shellState.focusApp.minimized = true;
        shellState.bookmarksVisible = true;
        // Ocultar el tab outer wrapper — los hijos (Inherited) heredan.
        if (shellState.focusApp.tabId > 0 && dimention.tabs) {
          dimention.tabs.setVisible(shellState.focusApp.tabId, false);
        }
        sendMessageToApp(shellState.focusApp.tabId, 'blur');
        applyVisibility();
      }

      function onTapFocusAnchor() {
        // TODO(commit 4): pasar focus → anchored.
        console.log('[ux_vr] anchor: not implemented (commit 4)');
      }

      // ── Open embedded app ──────────────────────────────────────────────
      // Diferencia de openBookmark (apps spatial/app normales):
      //   - No cierra bookmarks de inmediato.
      //   - Setea focusApp en ShellState.
      //   - Cuando la app pida 'requestSlot', shell le manda el slot y oculta bookmarks.
      function openEmbeddedApp(bm) {
        // El shell mantiene su pose actual (la que tenía cuando aparecieron
        // los bookmarks). NO re-leemos viewer pose acá: si el user movió la
        // cabeza entre abrir el menú y clickear la app, el shell se saltaría
        // visualmente — todo el menú parpadearía al moverse. El frame del
        // focus aparece exactamente sobre la posición del shell visible.
        if (shellState.focusApp) {
          sendMessageToApp(shellState.focusApp.tabId, 'close');
          if (dimention.tabs) dimention.tabs.close(shellState.focusApp.tabId);
          shellState.focusApp = null;
        }

        // El tab_id real lo asigna el host. NO podemos saberlo desde acá sin
        // un callback. Heurística: justo después del mount, el host le da el
        // siguiente tabId secuencial. Mejor: cuando la app mande 'ready', leemos
        // su tabId del fromTabId del mensaje y completamos focusApp.
        // Por ahora marcamos focusApp con tabId=0 (pending) — cuando llegue
        // ready, lo completamos.
        shellState.focusApp = {
          tabId: 0,        // pending — completado en 'ready'
          minimized: false,
          title: bm.name,
          pendingUrl: bm.url,
        };
        dimention.tabs.open(bm.url, { kind: 'app-embedded' });

        // Mantenemos bookmarksVisible=true: la sesión del shell sigue activa.
        // Las reglas derivadas (shouldShowBookmarks / shouldShowBottomBar) hacen
        // el resto — panel se oculta porque focus está visible, bar queda
        // visible para volver a marcadores. Modelo literal del doc:
        //   panel = bookmarks_visible && (no focus || focus.minimized)
        //   bar   = bookmarks_visible && (focus.is_some() || anchored.len > 0)
        applyVisibility();
      }

      // ── Bookmark click ─────────────────────────────────────────────────
      function openBookmark(bm) {
        if (!dimention || !dimention.tabs || typeof dimention.tabs.open !== 'function') {
          console.warn('[ux_vr] dimention.tabs unavailable — fallback location.href');
          location.href = bm.url;
          return;
        }

        if (bm.kind === 'app-embedded') {
          openEmbeddedApp(bm);
          return;
        }

        // Spatial / app normal — comportamiento previo.
        dimention.tabs.open(bm.url, { kind: bm.kind || 'spatial' });
        shellState.bookmarksVisible = false;
        applyVisibility();
        startExitAnimation();
      }

      // ── Mensaje recibido de una app embedded ───────────────────────────
      function handleAppMessage(msg) {
        const fromTabId = Number(msg.fromTabId || 0);
        let parsed = null;
        try { parsed = JSON.parse(msg.payload); } catch (_) {}
        if (!parsed || typeof parsed !== 'object') return;
        const type = String(parsed.type || '').toLowerCase();

        // Si focusApp.tabId estaba pending (0) y la app manda algo, capturamos
        // el tabId del primer mensaje que llegue de la app correcta.
        if (shellState.focusApp && shellState.focusApp.tabId === 0 && fromTabId > 0) {
          shellState.focusApp.tabId = fromTabId;
          // Construir frame con tabId temporalmente "pending" → applyVisibility
          // mantiene focusZone oculto mientras los spawn commands se commitean.
          // Tras un par de frames, marcamos tabId definitivo + slot a la app.
          buildFocusFrame(shellState.focusApp.title || 'App');
          sendFocusSlotToApp();
          // Defer reveal del frame hasta que los spawn commits (boxes/text del
          // titlebar) ya estén renderizados. Sin esto, applyVisibility hace
          // visible focusZone antes de que los hijos tengan Transform Bevy
          // sincronizado → parpadeo de frame vacío durante 1-3 frames.
          const revealId = shellState.focusApp.tabId;
          setTimeout(() => {
            if (shellState.focusApp && shellState.focusApp.tabId === revealId) {
              applyVisibility();
            }
          }, 50);
        }

        if (type === 'requestslot') {
          // App pide slot — shell responde con la pose del focus actual.
          sendFocusSlotToApp();
        } else if (type === 'ready') {
          // No-op por ahora — el shell ya captura el tabId del primer mensaje.
        } else if (type === 'closeself') {
          if (shellState.focusApp && shellState.focusApp.tabId === fromTabId) {
            onTapFocusClose();
          }
          // TODO(commit 4): anchored self-close.
        }
      }

      // Poll loop: drena inbox del shell cada 16ms.
      function pollShellInbox() {
        const msgs = Deno.core.ops.op_shell_poll_messages();
        if (Array.isArray(msgs) && msgs.length) {
          for (const m of msgs) handleAppMessage(m);
        }
        setTimeout(pollShellInbox, 16);
      }
      pollShellInbox();

      // ── Listener system input ──────────────────────────────────────────
      root.addEventListener('systeminput', (evt) => {
        if (evt.action === 'shell') {
          toggleShell();
        }
      });

      // ── Init ───────────────────────────────────────────────────────────
      buildBookmarks();
      applyVisibility();
      console.log('[ux_vr] Shell loaded —', BOOKMARKS.length, 'bookmarks');
    </script>
  </space>
</hsml>
