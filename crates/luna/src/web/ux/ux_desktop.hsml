<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>UX Desktop</name>
  </head>

  <!-- Controller de escritorio.
       El mismo shell que el de VR: `shell_app.js` con el estado, las ventanas y
       el puente al motor, y el menú como `<include>` aparte. Lo único que cambia
       entre los dos controllers son tres cosas, y todas están en este archivo:

         · qué menú se incluye — acá el plano, allá el curvo
         · a qué distancia se planta — una pantalla tiene mucho menos campo
           visual que un visor, así que el mismo menú a la misma distancia acá no
           entra en el cuadro
         · de dónde sale el gesto de abrirlo — ESC en vez del botón del mando,
           aunque los dos llegan como el mismo evento `systeminput`

       El panel de egui sigue estando y queda como legacy. -->
  <space id="ux_desktop" resources="desktop_camera_control,vr_locomotion,read_system_input,manage_tabs,read_hmd_pose">
    <!-- `props` y `events` son lo que abre el canal de componentes: sin al menos
         uno de los dos el motor no crea el Channel y el include queda mudo.
         `props` arranca vacío porque el estado real se lo manda el shell apenas
         monta; `events` declara los únicos tipos que el menú puede emitir. -->
    <include id="ux_desktop_menu"
             src="luna://shell_menu_flat"
             props="{}"
             events="open,menu,window,close,hidden"/>

    <group id="ux_desktop_focus_zone" visible="false"/>
    <group id="ux_desktop_anchored_zone" visible="true"/>

    <script src="luna://internal/shell_draw.js"/>
    <script src="luna://internal/shell_app.js"/>
    <script>
      // El root publica y persiste el catálogo común mediante component.props.

      // El menú plano mide ~2,4 m de ancho. En un visor eso se recorre girando
      // la cabeza; en una pantalla hay que alejarlo o no entra de alto.
      const DISTANCIA = 2.6;

      (function esperar(intentos) {
        if (!globalThis.ShellDraw || !globalThis.ShellApp) {
          if (intentos > 200) { console.warn('[ux_desktop] el shell no llegó'); return; }
          setTimeout(() => esperar(intentos + 1), 16);
          return;
        }
        armar();
      })(0);

      function armar() {
        const root = hiperspace.dimention;

        const shell = globalThis.ShellApp.mount({
          root: root,
          menuInclude: root.getElementById('ux_desktop_menu'),
          focusZone: root.getElementById('ux_desktop_focus_zone'),
          anchoredZone: root.getElementById('ux_desktop_anchored_zone'),
          sharedItems: true,
          distance: DISTANCIA,
          // El menú plano mide ~2,4 m y se planta a 2,6: una ventana de un
          // metro ahí se ve la mitad de lo que se veía la grilla y queda
          // flotando al fondo. Ocupa el lugar que dejó.
          slot: { w: 2.1, h: 1.4, d: 0.2 },
          // Una ventana de 1,4 de alto con su barra de título abajo llega
          // hasta -0,80, y la barra del menú arranca en -0,77: se pisaban.
          windowLift: 0.16,

          tabs: {
            open: (url, opts) => dimention.tabs.open(url, opts),
            close: (id) => dimention.tabs.close(id),
            setVisible: (id, v) => dimention.tabs.setVisible(id, v),
          },
          send: (tabId, payload) => Deno.core.ops.op_shell_send_message(BigInt(tabId), payload),
          poll: () => Deno.core.ops.op_shell_poll_messages(),
          // En escritorio esto lee la cámara, no un visor. Al montar el shell la
          // cámara todavía no existe y devuelve null; el shell lo contempla y se
          // planta igual la primera vez que se abre.
          viewerPose: () => (typeof dimention.readViewerPose === 'function'
            ? dimention.readViewerPose() : null),
          navigate: (url) => { location.href = url; },
        });

        // ESC en escritorio; el mismo evento que manda el botón menu del mando
        // en VR, normalizado por `system_input`.
        root.addEventListener('systeminput', (evt) => {
          if (evt.action === 'shell') shell.toggle();
        });

        // El shell arranca escondido, igual que en VR: se abre con el gesto. Una
        // pantalla ya tiene el panel de egui a mano, así que abrirlo solo taparía
        // lo que el usuario estaba mirando.
        console.log('[ux_desktop] shell montado con catálogo del root');
      }
    </script>
  </space>
</hsml>
