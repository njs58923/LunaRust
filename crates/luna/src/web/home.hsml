<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>Luna Home</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <space resources="navigate_self">
    <!-- Small sign ahead of the viewer; the rest of the island stays empty. -->
    <group id="home_navigation" z="-3.5">
      <text y="1.95" value="Luna" size="0.32" color="#344C49"/>
      <text y="1.62" value="Tu espacio de inicio" size="0.085" color="#4E6560"/>

      <box id="btn_demos" x="-0.86" y="1.15" sx="0.78" sy="0.28" sz="0.06" color="#405E55" touchable="true"/>
      <text x="-0.86" y="1.15" z="0.04" value="Explorar" size="0.075" color="#F4F1E5"/>
      <box id="btn_settings" y="1.15" sx="0.78" sy="0.28" sz="0.06" color="#405E55" touchable="true"/>
      <text y="1.15" z="0.04" value="Ajustes" size="0.075" color="#F4F1E5"/>
      <box id="btn_about" x="0.86" y="1.15" sx="0.78" sy="0.28" sz="0.06" color="#405E55" touchable="true"/>
      <text x="0.86" y="1.15" z="0.04" value="Acerca de" size="0.075" color="#F4F1E5"/>
    </group>
    <script src="luna://internal/home_navigation.js"/>
  </space>
</hsml>
