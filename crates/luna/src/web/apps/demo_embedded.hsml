<?xml version="1.0" encoding="UTF-8"?>
<hsml>
  <head>
    <name>Demo Embedded</name>
    <meta type="position" x="0" y="0" z="0"/>
    <meta type="scale" x="1" y="1" z="1"/>
    <meta type="rotation" x="0" y="0" z="0"/>
  </head>
  <!-- resources= debe declarar `ux_embed` para que se auto-inyecte
       embedded_api.js en este worker. La cap proviene por entry-grant del
       wrapper outer (managed-by=dimension.luna con ux_embed); el inner la
       acepta porque la solicita explícitamente. -->
  <space role="application-embedded" resources="navigate_self,ux_embed">
    <!-- Contenido construido dinámicamente cuando el shell asigna slot. -->
    <group id="demo_root">
    </group>

    <script>
      // ────────────────────────────────────────────────────────────────────
      // Demo embedded app — valida el bus shell ↔ app.
      // - Pide slot al shell vía dimention.embedded.requestSlot.
      // - Cuando el shell responde con 'slot', dibuja un box rojo centrado.
      // - Maneja 'focus', 'blur', 'suspend', 'resume', 'close' del shell.
      // ────────────────────────────────────────────────────────────────────

      const root = hiperspace.dimention;
      const myGroup = root.getElementById('demo_root');

      // Init async — el auto-script `embedded_api.js` puede correr DESPUÉS
      // que este inline. Polleamos `dimention.embedded` hasta que aparezca,
      // máx ~250ms. Sin esto, el `if (!dimention.embedded)` retornaba
      // missing aunque el script estuviera listo en el próximo tick.
      function waitForEmbedded(attempts, cb) {
        if (dimention && dimention.embedded) { cb(dimention.embedded); return; }
        if (attempts > 50) {
          console.error('[demo_embedded] dimention.embedded never appeared — cap ux_embed missing?');
          return;
        }
        setTimeout(() => waitForEmbedded(attempts + 1, cb), 5);
      }

      waitForEmbedded(0, function(e) {
        let contentBox = null;
        let labelText  = null;

        function renderInSlot(size) {

          const sx = (size && size.x) ? Number(size.x) : 1.0;
          const sy = (size && size.y) ? Number(size.y) : 0.7;

          if (contentBox && labelText) {
            contentBox.scale = { x: sx * 0.8, y: sy * 0.8, z: 0.03 };
            return;
          }

          // Box rojo centrado, llenando ~80% del slot.
          contentBox = root.createElement('box');
          contentBox.setAttribute('color', '#EF4444');
          contentBox.setAttribute('border-radius', '0.05');
          contentBox.position = { x: 0, y: 0, z: 0 };
          contentBox.scale = { x: sx * 0.8, y: sy * 0.8, z: 0.03 };
          myGroup.appendChild(contentBox);

          labelText = root.createElement('text');
          labelText.setAttribute('value', 'Demo Embedded');
          labelText.setAttribute('size', '0.06');
          labelText.setAttribute('color', '#FFFFFF');
          labelText.position = { x: 0, y: 0, z: 0.02 };
          myGroup.appendChild(labelText);
        }

        e.on('slot', (slot) => {
          // The host owns placement for window-local slots. Content stays local
          // even when the shell moves while this worker is busy or suspended.
          if (slot.coordinateSpace !== 'window-local') {
            if (slot.position) root.position = slot.position;
            if (slot.rotation) root.rotation = slot.rotation;
          }
          renderInSlot(slot.size);
        });

        // El shell controla la visibilidad del tab outer wrapper via
        // dimention.tabs.setVisible. Con Visibility::Inherited en los hijos,
        // se propaga a este space y a su contenido. Los eventos focus/blur
        // son informativos — no requieren acción de visibility de la app.
        e.on('focus', () => console.log('[demo_embedded] gained focus'));
        e.on('blur',  () => console.log('[demo_embedded] lost focus'));
        e.on('suspend', () => console.log('[demo_embedded] suspend (TODO: pause loops)'));
        e.on('resume',  () => console.log('[demo_embedded] resume'));
        e.on('close',   () => {
          console.log('[demo_embedded] close — cleanup');
          if (contentBox) { try { contentBox.remove(); } catch (_) {} contentBox = null; }
          if (labelText)  { try { labelText.remove();  } catch (_) {} labelText  = null; }
        });

        // Pedir slot al shell con tamaño preferido.
        e.requestSlot({
          title: 'Demo Embedded',
          minSize:       { x: 0.8, y: 0.6, z: 0.1 },
          preferredSize: { x: 1.0, y: 0.7, z: 0.1 },
        });
        e.notifyReady();
      });
    </script>
  </space>
</hsml>
