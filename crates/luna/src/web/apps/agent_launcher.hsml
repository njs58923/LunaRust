<?xml version="1.0" encoding="UTF-8"?>
<!-- Lanzador del agente.
     Página spatial normal, con un botón. Al tocarlo monta `luna://agent_app`
     como app aditiva y se puede navegar a otra cosa: la app sigue viva.

     Está separado del puente a propósito. El puente necesita sobrevivir a la
     navegación, y una página spatial se reemplaza cuando navegás; si fueran el
     mismo documento, el agente se mataría a sí mismo en el primer `open`.
-->
<hsml>
  <head>
    <name>Agente Luna</name>
    <meta type="position" x="0" y="0" z="0"/>
  </head>

  <space resources="navigate_self,manage_tabs">
    <text y="2.35" z="-3" value="Agente Luna" size="0.26" color="#F2ECDF"/>
    <text y="2.05" z="-3" value="puente entre el navegador y el servidor MCP" size="0.09" color="#A79C8A"/>

    <plane y="1.35" z="-3.02" sx="2.6" sy="0.95" color="#2C2A26" border-radius="0.06"/>

    <box id="btn_iniciar" y="1.5" z="-2.95" sx="1.5" sy="0.3" sz="0.08"
         color="#2E7D32" touchable="true" border-radius="0.04"/>
    <text id="txt_boton" y="1.5" z="-2.89" value="Iniciar agente" size="0.1" color="#F2ECDF"/>

    <text id="estado" y="1.1" z="-2.99" value="sin iniciar" size="0.075" color="#A79C8A"/>

    <script>
      const root = hiperspace.dimention;
      const boton = root.getElementById('btn_iniciar');
      const txtBoton = root.getElementById('txt_boton');
      const estado = root.getElementById('estado');

      let montado = false;

      function decir(msg) {
        if (estado) estado.setAttribute('value', msg);
        console.log('[agente-launcher]', msg);
      }

      if (boton) {
        boton.addEventListener('toque', () => {
          if (montado) {
            decir('el agente ya está corriendo');
            return;
          }
          if (!dimention.tabs || typeof dimention.tabs.open !== 'function') {
            decir('falta manage_tabs: montalo desde el shell');
            return;
          }

          // kind 'app' = aditivo: sobrevive a los cambios de espacio spatial.
          //
          // open() no devuelve nada a propósito (tabs_api.js): el tab_id lo
          // asigna el host después. Así que acá no hay confirmación posible —
          // y tampoco alcanza con mirar: la app corre en su propio isolate,
          // invisible desde este documento. La confirmación real es
          // `luna_status` del lado del MCP, o el log del Devtool.
          dimention.tabs.open('luna://agent_app', { kind: 'app' });
          montado = true;
          if (boton) boton.setAttribute('color', '#3A3F3B');
          if (txtBoton) txtBoton.setAttribute('value', 'agente montado');
          decir('pedido enviado — confirmá con luna_status');
        });
      }

      decir('tocá el botón para montar el puente');
    </script>
  </space>
</hsml>
